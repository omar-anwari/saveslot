ROM_LIBRARY_PATH=./dev-library
APPT_DATA_PATH=./dev-data
DATABASE_URL=./dev-data/app.sqlite

APP_URL=http://localhost:3000
APP_NAME=SaveSlot
NODE_ENV=development
LOG_LEVEL=info

APP_PASSWORD=
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

HASHEOUS_ENABLED=true
HASHEOUS_BASE_URL=https://hasheous.org
METADATA_REQUEST_TIMEOUT_MS=60000
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SCREENSCRAPER_USERNAME=
SCREENSCRAPER_PASSWORD=
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

SCAN_HASH_ALGORITHMS=md5,sha1,crc32
SCAN_CONCURRENCY=2
METADATA_CONCURRENCY=1
METADATA_REQUEST_DELAY_MS=250

EMULATORJS_VERSION=4.2.3
EMULATORJS_DATA_PATH=/emulatorjs/data/
EMULATORJS_FIXED_SAVE_INTERVAL_MS=15000
EMULATORJS_THREADS=auto

MAX_SAVE_BYTES=16777216
MAX_STATE_BYTES=536870912
SAVE_HISTORY_LIMIT=10
STATE_HISTORY_LIMIT=25

ALLOW_FAKE_ROM_FIXTURES=false