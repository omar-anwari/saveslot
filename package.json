{
  "name": "saveslot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25.0.0",
    "pnpm": ">=11.24.0 <12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local --conditions=react-server db/seed.ts",
    "scan": "node --env-file-if-exists=.env.local --conditions=react-server scripts/scan.ts",
    "metadata": "node --env-file-if-exists=.env.local --conditions=react-server scripts/metadata.ts",
    "fixtures": "node --env-file-if-exists=.env.local --conditions=react-server scripts/create-dev-fixtures.ts",
    "doctor": "node --env-file-if-exists=.env.local --conditions=react-server scripts/doctor.ts",
    "setup:local": "node --env-file-if-exists=.env.local --conditions=react-server scripts/setup-local.ts",
    "emulatorjs:sync": "node --env-file-if-exists=.env.local --conditions=react-server scripts/emulatorjs-sync.ts",
    "emulatorjs:check": "node --env-file-if-exists=.env.local --conditions=react-server scripts/emulatorjs-sync.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
